{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd attendance_demo/backend && pip install -r ../../requirements.txt"
  },
  "deploy": {
    "startCommand": "cd attendance_demo/backend && uvicorn main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/healthcheck",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
